# 换行符策略：仓库内统一存 LF，检出时也用 LF（团队以 Linux 为主）
* text=auto eol=lf

# Windows 专用脚本保留 CRLF，否则 cmd.exe / PowerShell 可能不认
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件禁止任何换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.exe  binary
*.dll  binary
*.pt   binary
*.pth  binary
*.onnx binary
